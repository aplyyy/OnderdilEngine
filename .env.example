# Environment Variables Template (DO NOT COMMIT REAL SECRETS)
# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Koneksi Database PostgreSQL (misal Neon.tech / Supabase / PostgreSQL lokal)
DATABASE_URL="postgresql://user:password@localhost:5432/onderdil_engine?schema=public"

# Kunci Rahasia JWT untuk Enkripsi Token Sesi (Minimal 32 karakter acak)
JWT_SECRET="ganti_dengan_random_secret_minimal_32_karakter_kriptografi_aman"

# Identitas Aplikasi
NEXT_PUBLIC_APP_NAME="OnderdilEngine - POS Bengkel Mobil"
NODE_ENV="development"
